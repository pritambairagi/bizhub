# ==========================================
# BizHub Server Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bizhub

# Security & Authentication
JWT_ACCESS_SECRET=your_super_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_super_jwt_refresh_secret_key_change_in_production

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Service (SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Cloudinary Configuration (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateways (Optional / Production)
# ------------------------------------------

# SSLCommerz Configuration
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# bKash Configuration
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Configuration
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
