# ==========================================
# BizHub Client - Production & Dev Environment Template
# ==========================================

# Brand Identity & SEO Config
VITE_APP_NAME=BizHub
VITE_APP_TITLE=BizHub | All in one business management solution
VITE_APP_DESCRIPTION=BizHub - Enterprise ERP & POS for Bangladesh

# Port for local development
PORT=5173

# ─── BACKEND URL (MASTER CONTROL) ───
# When deploying to Vercel, change this to your live production backend URL.
# This single variable controls both API endpoints and real-time Socket.io connections!
# Example: VITE_BACKEND_URL=https://bizhub-server.onrender.com
VITE_BACKEND_URL=http://localhost:5000

# ─── ADVANCED API/SOCKET OVERRIDES (OPTIONAL) ───
# If VITE_BACKEND_URL is set, it will automatically override VITE_API_URL and VITE_SOCKET_URL.
# If VITE_BACKEND_URL is left blank, the app falls back to these variables:
VITE_API_URL=/api/v1
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io

# Local Development Settings (Used by Vite Proxy when VITE_BACKEND_URL is empty)
VITE_BACKEND_PORT=5000
